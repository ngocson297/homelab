generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(uuid())
  scheduledAt DateTime
  status      BookingStatus @default(REQUESTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([scheduledAt])
}

enum LabTestStatus {
  ACTIVE
  INACTIVE
}

model LabTest {
  id                             String        @id @default(uuid())
  code                           String        @unique
  name                           String
  description                    String?       @db.Text
  specimenType                   String
  containerType                  String
  minimumVolumeMl                Decimal?      @db.Decimal(6, 2)
  preparationInstruction         String?       @db.Text
  collectionGroupKey             String?
  targetCollectionVolumeMl       Decimal?      @db.Decimal(6, 2)
  specimenPreparationInstruction String?       @db.Text
  transportInstruction           String?       @db.Text
  specimenStabilityHours         Int?
  turnaroundTimeHours            Int
  homeCollectable                Boolean       @default(false)
  price                          Decimal       @db.Decimal(12, 2)
  status                         LabTestStatus @default(ACTIVE)
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt
  orderItems                     OrderItem[]

  @@index([name])
  @@index([homeCollectable, status])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "LabTest_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "LabTest_name_trgm_idx")
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COLLECTOR_ASSIGNED
  COLLECTOR_ON_THE_WAY
  COLLECTED
  IN_TRANSIT
  RECEIVED_AT_LAB
  CANCELLED
}

model Order {
  id                         String                       @id @default(uuid())
  orderCode                  String                       @unique
  status                     OrderStatus                  @default(PENDING_CONFIRMATION)
  contactName                String
  contactPhone               String
  subtotal                   Decimal                      @db.Decimal(12, 2)
  collectionFee              Decimal                      @db.Decimal(12, 2)
  totalAmount                Decimal                      @db.Decimal(12, 2)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  version                    Int                          @default(1)
  currentCollectorProfileId  String?
  requiresRecollection       Boolean                      @default(false)
  items                      OrderItem[]
  appointment                Appointment?
  statusHistory              OrderStatusHistory[]
  currentCollector           CollectorProfile?            @relation("CurrentCollector", fields: [currentCollectorProfileId], references: [id], onDelete: Restrict)
  collectorAssignmentHistory CollectorAssignmentHistory[]
  subject                    OrderSubject?
  collectionAttempts         CollectionAttempt[]
  specimens                  Specimen[]

  @@index([createdAt])
  @@index([currentCollectorProfileId])
}

enum SubjectSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model OrderSubject {
  id                    String     @id @default(uuid())
  orderId               String     @unique
  fullName              String
  dateOfBirth           DateTime   @db.Date
  sex                   SubjectSex
  relationshipToContact String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  order                 Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  status      OrderStatus
  title       String
  description String?     @db.Text
  occurredAt  DateTime    @default(now())
  operationId String?     @db.Uuid
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, operationId])
  @@index([orderId, occurredAt])
}

model OrderItem {
  id                               String             @id @default(uuid())
  orderId                          String
  labTestId                        String
  testCodeSnapshot                 String
  testNameSnapshot                 String
  specimenTypeSnapshot             String
  containerTypeSnapshot            String
  collectionGroupKeySnapshot       String?
  targetCollectionVolumeMlSnapshot Decimal?           @db.Decimal(6, 2)
  preparationInstructionSnapshot   String?            @db.Text
  transportInstructionSnapshot     String?            @db.Text
  priceSnapshot                    Decimal            @db.Decimal(12, 2)
  createdAt                        DateTime           @default(now())
  order                            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTest                          LabTest            @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  specimenLink                     SpecimenOrderItem?

  @@unique([orderId, labTestId])
  @@index([labTestId])
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
}

model Appointment {
  id            String            @id @default(uuid())
  orderId       String            @unique
  scheduledDate DateTime
  timeSlot      String
  province      String
  district      String
  ward          String
  addressLine   String
  note          String?           @db.Text
  status        AppointmentStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([scheduledDate, status])
}

enum StaffRole {
  ADMIN
  LAB_STAFF
  COLLECTOR
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffUser {
  id                            String                       @id @default(uuid())
  email                         String                       @unique
  passwordHash                  String
  fullName                      String
  role                          StaffRole
  status                        StaffStatus                  @default(ACTIVE)
  lastLoginAt                   DateTime?
  passwordChangedAt             DateTime                     @default(now())
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  sessions                      StaffSession[]
  auditLogs                     AdminAuditLog[]
  collectorProfile              CollectorProfile?
  performedCollectorAssignments CollectorAssignmentHistory[] @relation("AssignmentPerformer")
  receivedSpecimens             Specimen[]                   @relation("SpecimenReceiver")
  specimenCustodyEvents         SpecimenCustodyEvent[]       @relation("CustodyStaffActor")

  @@index([status])
}

enum CollectorOperationalStatus {
  AVAILABLE
  OFF_DUTY
  INACTIVE
}

enum CollectorAssignmentAction {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

model CollectorProfile {
  id                    String                       @id @default(uuid())
  staffUserId           String                       @unique
  employeeCode          String                       @unique
  phone                 String
  phoneNormalized       String
  operationalStatus     CollectorOperationalStatus   @default(OFF_DUTY)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  staffUser             StaffUser                    @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  serviceAreas          CollectorServiceArea[]
  currentOrders         Order[]                      @relation("CurrentCollector")
  assignments           CollectorAssignmentHistory[] @relation("AssignedCollector")
  previousAssignments   CollectorAssignmentHistory[] @relation("PreviousCollector")
  collectionAttempts    CollectionAttempt[]
  collectedSpecimens    Specimen[]                   @relation("SpecimenCollector")
  specimenCustodyEvents SpecimenCustodyEvent[]       @relation("CustodyCollectorActor")

  @@index([employeeCode])
  @@index([phoneNormalized])
  @@index([operationalStatus])
}

enum CollectionAttemptStatus {
  ON_THE_WAY
  COLLECTED
  IN_TRANSIT
  FAILED
}

enum CollectionFailureReason {
  PATIENT_UNAVAILABLE
  IDENTITY_MISMATCH
  PATIENT_DECLINED
  UNSAFE_ENVIRONMENT
  COLLECTION_NOT_POSSIBLE
  OTHER
}

model CollectionAttempt {
  id                 String                   @id @default(uuid())
  orderId            String
  collectorProfileId String
  attemptNumber      Int
  status             CollectionAttemptStatus
  startedAt          DateTime
  collectedAt        DateTime?
  inTransitAt        DateTime?
  failedAt           DateTime?
  failureReason      CollectionFailureReason?
  failureNote        String?                  @db.Text
  identityVerifiedAt DateTime?
  consentConfirmedAt DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  order              Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectorProfile   CollectorProfile         @relation(fields: [collectorProfileId], references: [id], onDelete: Restrict)

  @@unique([orderId, attemptNumber])
  @@index([orderId])
  @@index([collectorProfileId])
  @@index([status])
  @@index([startedAt])
}

model CollectorServiceArea {
  id                 String           @id @default(uuid())
  collectorProfileId String
  province           String
  district           String?
  provinceNormalized String
  districtNormalized String?
  createdAt          DateTime         @default(now())
  collectorProfile   CollectorProfile @relation(fields: [collectorProfileId], references: [id], onDelete: Cascade)

  @@index([collectorProfileId])
  @@index([provinceNormalized, districtNormalized])
}

model CollectorAssignmentHistory {
  id                         String                    @id @default(uuid())
  orderId                    String
  collectorProfileId         String?
  previousCollectorProfileId String?
  action                     CollectorAssignmentAction
  performedByStaffUserId     String
  reason                     String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  order                      Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectorProfile           CollectorProfile?         @relation("AssignedCollector", fields: [collectorProfileId], references: [id], onDelete: Restrict)
  previousCollectorProfile   CollectorProfile?         @relation("PreviousCollector", fields: [previousCollectorProfileId], references: [id], onDelete: Restrict)
  performedBy                StaffUser                 @relation("AssignmentPerformer", fields: [performedByStaffUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([collectorProfileId, createdAt])
  @@index([previousCollectorProfileId, createdAt])
  @@index([performedByStaffUserId, createdAt])
}

model AdminAuditLog {
  id              String    @id @default(uuid())
  staffUserId     String
  action          String
  entityType      String
  entityReference String
  metadata        Json?
  createdAt       DateTime  @default(now())
  staffUser       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([staffUserId, createdAt])
  @@index([entityType, entityReference, createdAt])
}

model StaffSession {
  id          String    @id @default(uuid())
  staffUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
}

enum SpecimenStatus {
  PLANNED
  LABELED
  COLLECTED
  IN_TRANSIT
  RECEIVED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SpecimenRejectionReason {
  HEMOLYZED
  CLOTTED
  INSUFFICIENT_VOLUME
  WRONG_CONTAINER
  UNLABELED
  LABEL_MISMATCH
  LEAKING
  TRANSPORT_TEMPERATURE_FAILED
  TRANSPORT_DELAYED
  DAMAGED
  OTHER
}

enum SpecimenCustodyEventType {
  SPECIMEN_PLANNED
  LABEL_GENERATED
  LABEL_PRINTED
  SPECIMEN_COLLECTED
  HANDED_TO_TRANSPORT
  RECEIVED_AT_LAB
  SPECIMEN_ACCEPTED
  SPECIMEN_REJECTED
}

enum CustodyActorType {
  SYSTEM
  ADMIN
  COLLECTOR
  LAB_STAFF
}

model Specimen {
  id                            String                   @id @default(uuid())
  specimenCode                  String                   @unique
  barcodeValue                  String                   @unique
  orderId                       String
  status                        SpecimenStatus
  specimenType                  String
  containerType                 String
  collectionGroupKey            String?
  targetVolumeMl                Decimal?                 @db.Decimal(6, 2)
  collectedVolumeMl             Decimal?                 @db.Decimal(6, 2)
  requiresManualReview          Boolean                  @default(false)
  collectedAt                   DateTime?
  collectedByCollectorProfileId String?
  inTransitAt                   DateTime?
  receivedAt                    DateTime?
  receivedByStaffUserId         String?
  acceptedAt                    DateTime?
  rejectedAt                    DateTime?
  rejectionReason               SpecimenRejectionReason?
  rejectionNote                 String?                  @db.Text
  recollectionRequired          Boolean                  @default(false)
  version                       Int                      @default(1)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  order                         Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  collectedBy                   CollectorProfile?        @relation("SpecimenCollector", fields: [collectedByCollectorProfileId], references: [id], onDelete: Restrict)
  receivedBy                    StaffUser?               @relation("SpecimenReceiver", fields: [receivedByStaffUserId], references: [id], onDelete: Restrict)
  orderItems                    SpecimenOrderItem[]
  custodyEvents                 SpecimenCustodyEvent[]

  @@index([orderId])
  @@index([status])
  @@index([collectedByCollectorProfileId])
  @@index([receivedByStaffUserId])
}

model SpecimenOrderItem {
  id          String    @id @default(uuid())
  specimenId  String
  orderItemId String    @unique
  createdAt   DateTime  @default(now())
  specimen    Specimen  @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([specimenId, orderItemId])
  @@index([specimenId])
}

model SpecimenCustodyEvent {
  id                      String                   @id @default(uuid())
  specimenId              String
  eventType               SpecimenCustodyEventType
  actorType               CustodyActorType
  actorStaffUserId        String?
  actorCollectorProfileId String?
  operationId             String                   @db.Uuid
  occurredAt              DateTime                 @default(now())
  metadata                Json?
  createdAt               DateTime                 @default(now())
  specimen                Specimen                 @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  actorStaffUser          StaffUser?               @relation("CustodyStaffActor", fields: [actorStaffUserId], references: [id], onDelete: Restrict)
  actorCollectorProfile   CollectorProfile?        @relation("CustodyCollectorActor", fields: [actorCollectorProfileId], references: [id], onDelete: Restrict)

  @@unique([specimenId, eventType, operationId])
  @@index([specimenId, occurredAt])
  @@index([actorStaffUserId, occurredAt])
  @@index([actorCollectorProfileId, occurredAt])
}
