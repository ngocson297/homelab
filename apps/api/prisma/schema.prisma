generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(uuid())
  scheduledAt DateTime
  status      BookingStatus @default(REQUESTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([scheduledAt])
}

enum LabTestStatus {
  ACTIVE
  INACTIVE
}

model LabTest {
  id                     String        @id @default(uuid())
  code                   String        @unique
  name                   String
  description            String?       @db.Text
  specimenType           String
  containerType          String
  minimumVolumeMl        Decimal?      @db.Decimal(6, 2)
  preparationInstruction String?       @db.Text
  turnaroundTimeHours    Int
  homeCollectable        Boolean       @default(false)
  price                  Decimal       @db.Decimal(12, 2)
  status                 LabTestStatus @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  orderItems             OrderItem[]

  @@index([name])
  @@index([homeCollectable, status])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "LabTest_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "LabTest_name_trgm_idx")
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COLLECTOR_ASSIGNED
  CANCELLED
}

model Order {
  id            String       @id @default(uuid())
  orderCode     String       @unique
  status        OrderStatus  @default(PENDING_CONFIRMATION)
  contactName   String
  contactPhone  String
  subtotal      Decimal      @db.Decimal(12, 2)
  collectionFee Decimal      @db.Decimal(12, 2)
  totalAmount   Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  version       Int          @default(1)
  currentCollectorProfileId String?
  items         OrderItem[]
  appointment   Appointment?
  statusHistory OrderStatusHistory[]
  currentCollector CollectorProfile? @relation("CurrentCollector", fields: [currentCollectorProfileId], references: [id], onDelete: Restrict)
  collectorAssignmentHistory CollectorAssignmentHistory[]

  @@index([createdAt])
  @@index([currentCollectorProfileId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  status      OrderStatus
  title       String
  description String?     @db.Text
  occurredAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  labTestId            String
  testCodeSnapshot     String
  testNameSnapshot     String
  specimenTypeSnapshot String
  priceSnapshot        Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTest              LabTest  @relation(fields: [labTestId], references: [id], onDelete: Restrict)

  @@unique([orderId, labTestId])
  @@index([labTestId])
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
}

model Appointment {
  id            String            @id @default(uuid())
  orderId       String            @unique
  scheduledDate DateTime
  timeSlot      String
  province      String
  district      String
  ward          String
  addressLine   String
  note          String?           @db.Text
  status        AppointmentStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([scheduledDate, status])
}

enum StaffRole {
  ADMIN
  LAB_STAFF
  COLLECTOR
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffUser {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  fullName          String
  role              StaffRole
  status            StaffStatus    @default(ACTIVE)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          StaffSession[]
  auditLogs         AdminAuditLog[]
  collectorProfile  CollectorProfile?
  performedCollectorAssignments CollectorAssignmentHistory[] @relation("AssignmentPerformer")

  @@index([status])
}

enum CollectorOperationalStatus {
  AVAILABLE
  OFF_DUTY
  INACTIVE
}

enum CollectorAssignmentAction {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

model CollectorProfile {
  id                String                     @id @default(uuid())
  staffUserId       String                     @unique
  employeeCode      String                     @unique
  phone             String
  phoneNormalized   String
  operationalStatus CollectorOperationalStatus @default(OFF_DUTY)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  staffUser         StaffUser                  @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  serviceAreas      CollectorServiceArea[]
  currentOrders     Order[]                    @relation("CurrentCollector")
  assignments       CollectorAssignmentHistory[] @relation("AssignedCollector")
  previousAssignments CollectorAssignmentHistory[] @relation("PreviousCollector")

  @@index([employeeCode])
  @@index([phoneNormalized])
  @@index([operationalStatus])
}

model CollectorServiceArea {
  id                  String           @id @default(uuid())
  collectorProfileId  String
  province            String
  district            String?
  provinceNormalized  String
  districtNormalized  String?
  createdAt           DateTime         @default(now())
  collectorProfile    CollectorProfile @relation(fields: [collectorProfileId], references: [id], onDelete: Cascade)

  @@index([collectorProfileId])
  @@index([provinceNormalized, districtNormalized])
}

model CollectorAssignmentHistory {
  id                         String                    @id @default(uuid())
  orderId                    String
  collectorProfileId         String?
  previousCollectorProfileId String?
  action                     CollectorAssignmentAction
  performedByStaffUserId     String
  reason                     String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  order                      Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectorProfile           CollectorProfile?        @relation("AssignedCollector", fields: [collectorProfileId], references: [id], onDelete: Restrict)
  previousCollectorProfile   CollectorProfile?        @relation("PreviousCollector", fields: [previousCollectorProfileId], references: [id], onDelete: Restrict)
  performedBy                StaffUser                 @relation("AssignmentPerformer", fields: [performedByStaffUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([collectorProfileId, createdAt])
  @@index([previousCollectorProfileId, createdAt])
  @@index([performedByStaffUserId, createdAt])
}

model AdminAuditLog {
  id              String    @id @default(uuid())
  staffUserId     String
  action          String
  entityType      String
  entityReference String
  metadata        Json?
  createdAt       DateTime  @default(now())
  staffUser       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([staffUserId, createdAt])
  @@index([entityType, entityReference, createdAt])
}

model StaffSession {
  id          String    @id @default(uuid())
  staffUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
}
